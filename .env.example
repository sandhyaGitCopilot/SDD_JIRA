# Copy this file to .env and fill in your own values:
#     cp .env.example .env
# Then check your setup with:
#     jira-testgen doctor
#
# .env is gitignored and must never be committed. Your API token is never
# printed, logged, or written to any file by this tool.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your Jira Cloud site, including the scheme. A trailing slash is fine.
JIRA_BASE_URL=https://your-site.atlassian.net

# The account the tool acts as.
JIRA_EMAIL=you@example.com

# Create one at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your-api-token-here

# ---------------------------------------------------------------------------
# Optional — each line shows the default applied when left unset.
# The tool reports which defaults it used on every run (FR-035).
# ---------------------------------------------------------------------------

# Where test case issues are created.
# Default: the same project as the source story.
JIRA_PROJECT_KEY=

# The issue type created for each test case.
# Default: Task. A dedicated "Test" type exists only on sites with a
# test-management app installed, so Task is the safe default.
JIRA_TEST_ISSUE_TYPE=

# How each test case issue is linked to the source story.
# Default: Relates, which is present in a default Jira configuration.
JIRA_LINK_TYPE=

# The custom field holding acceptance criteria, if your team uses one,
# e.g. customfield_10040. Find the id with:
#     jira-testgen doctor --issue PROJ-123
# Default: unset, which means criteria are read from a section of the issue
# description labelled "Acceptance Criteria". The tool never guesses at an
# unnamed field.
JIRA_AC_FIELD=
